# Normalize line endings: store text as LF, check out as LF on every platform.
# Prevents the "LF will be replaced by CRLF" warnings on Windows (core.autocrlf=true).
* text=auto eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
